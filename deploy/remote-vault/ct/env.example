# /etc/notetaker-remote/env  (root:root 0400; installed by setup.sh from this
# file; edit by hand in the CT. NEVER commit a filled copy.)
# Format: KEY=value, no quotes, no `export`. systemd EnvironmentFile syntax.
# Every NR_* key read by Packages/RemoteServer (Config/RemoteConfig.swift,
# OAuth/OAuthSettings.swift). Values in <ANGLE_BRACKETS> are yours to supply.

# --- Required ---------------------------------------------------------------
# Canonical public URL: https://<node>.<tailnet>.ts.net  (no path, no slash).
NR_PUBLIC_URL=https://<NODE>.<TAILNET>.ts.net
# The single Google account allowed to log in.
NR_ALLOWED_EMAIL=<YOUR_GOOGLE_EMAIL>
# Pre-registered OAuth client id (no DCR). 16-128 chars of [A-Za-z0-9._~-].
# Generate: echo "nr-$(head -c 24 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=')"
# It is not secret but is specific: paste the same value into the claude.ai
# connector dialog (Advanced > OAuth Client ID).
NR_OAUTH_CLIENT_ID=<GENERATED_CLIENT_ID>
# Comma-separated https redirect URIs the client may use. claude.ai only.
NR_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# Google OAuth web client (Cloud Console; redirect URI registered there is
# NR_PUBLIC_URL + /auth/google/callback).
NR_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>.apps.googleusercontent.com
NR_GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

# --- Stage switches ----------------------------------------------------------
# STAGE 1 (tailnet-only, oauth-probe.sh): NR_ALLOW_LOOPBACK=1
# STAGE 2 (Funnel):                      NR_ALLOW_LOOPBACK=0   (status warns if 1)
NR_ALLOW_LOOPBACK=1
# Trust the LAST X-Forwarded-For hop as the client IP. Leave 0 until stage 2
# step "verify X-Forwarded-For" shows real client addresses on audit lines.
NR_TRUST_FORWARDED_FOR=0
# Reject /mcp from outside 160.79.104.0/21. Needs NR_TRUST_FORWARDED_FOR=1.
# Default OFF (design 00 section 9).
NR_ANTHROPIC_IP_ALLOWLIST=0

# --- Paths and network (defaults shown; state moved onto the encrypted volume)
NR_BIND=127.0.0.1:8787
NR_REPLICA_DIR=/srv/replica/inbox
# Index + token DB live on the LUKS volume (never in a vzdump archive).
NR_STATE_DIR=/srv/replica/state
NR_AUDIT_LOG=/var/log/notetaker-remote/audit.jsonl
# Host header allowlist (default: NR_PUBLIC_URL host, 127.0.0.1:*, localhost:*).
# NR_ALLOWED_HOSTS=
# Hours without a manifest change before tools report the replica stale.
NR_STALE_AFTER_HOURS=24

# --- Optional OAuth tuning (defaults shown) -----------------------------------
NR_ACCESS_TTL_SEC=900
NR_REFRESH_IDLE_DAYS=14
NR_REFRESH_ABSOLUTE_DAYS=30
NR_CODE_TTL_SEC=60
# Confidential-client hook: lowercase hex SHA-256 of a client secret. Unset =
# public client (PKCE only), which is what the pre-registered setup uses.
# NR_OAUTH_CLIENT_SECRET_SHA256=
# Google issuer override: test only; leave unset.
# NR_GOOGLE_ISSUER=https://accounts.google.com
# Non-loopback bind override: do not set (tailscaled fronts this service).
# NR_ALLOW_NONLOOPBACK_BIND=
