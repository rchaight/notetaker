# /etc/vault-backup/env  (root:root 0400; installed by setup.sh from this file
# only if absent; edit by hand in the CT. NEVER commit a filled copy.)
# Format: KEY=value, no leading spaces, no quotes, no `export`. systemd EnvironmentFile syntax.
# The B2 ADMIN key never goes in this file (it is typed into a `read -rs`
# shell for init and monthly maintenance). Values in <ANGLE_BRACKETS> are yours.

# Repository: same bucket as the legacy `vault` path, new path `vault-replica`.
# You create nothing here; fill in the bucket name.
RESTIC_REPOSITORY=b2:<BUCKET>:vault-replica
# Daily B2 application key id: created in the B2 console, restricted to the
# bucket, capabilities exactly listBuckets listFiles readFiles writeFiles,
# name prefix vault-replica/ (no deleteFiles).
B2_ACCOUNT_ID=<DAILY_KEY_ID>
# The daily key itself (shown once in the B2 console).
B2_ACCOUNT_KEY=<DAILY_KEY>
# Repository password: generate with `openssl rand -base64 33`; also store it
# in the password manager (losing it makes every backup unreadable).
RESTIC_PASSWORD=<RESTIC_PASSWORD>
# Local cache of encrypted repository files (not a secret): leave as is. It is
# the one value without a placeholder because it needs no filling in.
RESTIC_CACHE_DIR=/var/cache/vault-backup
